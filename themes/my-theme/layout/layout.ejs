<!doctype html>
<html lang="en" itemscope>
<head>
    <%- partial('partial/head/meta') %>
    <%- partial('partial/head/title') %>
    <%- partial('partial/head/fonts') %>
    <%- partial('partial/head/styles') %>
    <%- partial('partial/head/rss') %>
    <%- partial('partial/head/favicon') %>
    <%- partial('partial/head/og') %>
    <% if (is_tag() || page.thankYouPage) { %> <meta name="robots" content="noindex"> <% } %>

</head>
<%
  var bodyClasses = '';
  if (page.thankYouPage) {bodyClasses += 'thank-you '}
  if (is_post() && config.banners.main_banner && (config.banners.main_banner === 'top' || config.banners.main_banner === 'bottom')) { bodyClasses += 'b-bar-' + config.banners.main_banner + ' '}
  if (is_post() && config.banners.article_side_banner && is_post()) { bodyClasses += 'b-article-sidebar '}
  if (is_post()) { bodyClasses += 'post-page '}
  if (is_tag()) { bodyClasses += 'tag-page ' }
  if (page.isAboutPage) { bodyClasses += 'index-page ' }
  if (page.layout === 'homepage') { bodyClasses += 'newsletter-homepage-page ' }
  if (page.layout === 'landing') { bodyClasses += 'landing-page ' }
  if (page.layout === 'pills') { bodyClasses += 'pills-landing-page ' }
%>
<body class="<%- bodyClasses %>">

<!-- this is a "hack" since layout property selects "landing.ejs" which does not exist... -->
<% if (page.layout === 'landing' || page.layout === 'pills')  {%>
    <%- body %>
<% } else { %>
    <%- partial('partial/header') %>
    <main>
        <!-- markdown content from .md file -->
        <%- body %>

        <% if (is_post())  {%>
            <%- partial('partial/subscribe', {}, {caches: true}) %>
        <% } %>
    </main>

    <%- partial('partial/footer') %>
    <% if (page.layout !== 'homepage') { %>
        <%- partial('partial/ck-form', {}, {caches: true}) %>
    <% } %>

<% } %>

<%
var noPersistentBrowserIdentifiersMode = 'no-persistent-browser-identifiers';
var pageTrackingMode = page.trackingMode ||
    (page.layout === 'homepage' ? noPersistentBrowserIdentifiersMode : 'consent-managed');
var noPersistentBrowserIdentifiers = pageTrackingMode === noPersistentBrowserIdentifiersMode;
var privacy = config.privacy || {};
%>
<% if (!noPersistentBrowserIdentifiers) { %>
<%- partial('partial/privacy-controls', {footerless: page.layout === 'landing' || page.layout === 'pills'}) %>
<% } %>
<%
var privacyConfigJson = JSON.stringify({
    posthogKey: privacy.posthog_key,
    posthogHost: privacy.posthog_host,
    posthogAssetHost: privacy.posthog_asset_host,
    metaPixelId: privacy.meta_pixel_id,
    trackingMode: pageTrackingMode
}).replace(/</g, '\\u003c');
%>
<script>
window.DEV_ACADEMY_PRIVACY_CONFIG = <%- privacyConfigJson %>;
</script>
<script src="<%- url_for('/js/privacy/consent-runtime.js') %>" defer></script>
<script src="<%- url_for('/js/main.js') %>" defer></script>
</body>
</html>
