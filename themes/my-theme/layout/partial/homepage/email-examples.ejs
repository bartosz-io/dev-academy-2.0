<section class="newsletter-examples" aria-labelledby="newsletter-examples-title">
    <div class="container">
        <div class="newsletter-section-heading">
            <p class="newsletter-eyebrow">See what arrives in your inbox</p>
            <h2 id="newsletter-examples-title">One useful idea. 💡<br>Under five minutes.</h2>
            <p>Every email is a short Knowledge Pill — one practical lesson you can read in under five minutes and use right away.</p>
        </div>
        <div class="newsletter-email-grid">
            <div class="newsletter-email-card">
                <p class="newsletter-email-label newsletter-email-label-security">Security Email #1 · Clickjacking</p>
                <%- partial('partial/homepage/email-preview', {
                    pill: homepage.security_pill,
                    variant: 'security'
                }) %>
            </div>
            <div class="newsletter-email-card">
                <p class="newsletter-email-label newsletter-email-label-security-secondary">Security Email #2 · URL allow-list</p>
                <%- partial('partial/homepage/email-preview', {
                    pill: homepage.security_pill_2,
                    variant: 'security-secondary'
                }) %>
            </div>
        </div>
        <div class="newsletter-examples-form">
            <p class="newsletter-examples-form-title">Want the next security email in your inbox?</p>
            <%- partial('partial/homepage/newsletter-form', {
                placement: 'homepage_after_examples',
                formId: 'pills-after-examples',
                buttonLabel: 'Get the first email →'
            }) %>
        </div>
    </div>
</section>
