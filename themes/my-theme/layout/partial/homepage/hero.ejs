<section class="newsletter-hero" aria-labelledby="newsletter-hero-title">
    <div class="container newsletter-hero-grid">
        <div class="newsletter-hero-copy">
            <h1 id="newsletter-hero-title"><%= homepage.hero.title.before %> <span class="newsletter-highlight newsletter-highlight-security"><%= homepage.hero.title.highlight %></span> <%= homepage.hero.title.after %></h1>
            <p class="newsletter-hero-summary"><%= homepage.hero.summary %></p>
            <%- partial('partial/homepage/newsletter-form', {
                placement: 'homepage_hero',
                formId: 'get-free-pills',
                buttonLabel: 'Get the first email →',
                reassurance: 'Free. First Security lesson after confirmation. Unsubscribe anytime.'
            }) %>
        </div>
        <div class="newsletter-hero-previews" aria-label="Example Knowledge Pills">
            <article class="newsletter-mini-pill newsletter-mini-pill-security">
                <div class="newsletter-mini-pill-meta">
                    <%- partial('partial/homepage/email-icon') %>
                    <span><%= homepage.hero.security_card.label %> · <%= homepage.hero.security_card.time %></span>
                </div>
                <h2><%= homepage.hero.security_card.title %></h2>
                <p><%= homepage.hero.security_card.problem %></p>
                <code><%= homepage.hero.security_card.code %></code>
            </article>
            <article class="newsletter-mini-pill newsletter-mini-pill-security-secondary">
                <div class="newsletter-mini-pill-meta">
                    <%- partial('partial/homepage/email-icon') %>
                    <span><%= homepage.hero.security_card_2.label %> · <%= homepage.hero.security_card_2.time %></span>
                </div>
                <h2><%= homepage.hero.security_card_2.title %></h2>
                <p><%= homepage.hero.security_card_2.problem %></p>
                <code><%= homepage.hero.security_card_2.code %></code>
            </article>
        </div>
    </div>
</section>
