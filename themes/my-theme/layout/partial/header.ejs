<% if (is_post() && config.banners.main_banner && (config.banners.main_banner === 'top' || config.banners.main_banner === 'bottom')) { %>
    <%- partial('banners/main-banner') %>
<% } %>

<header class="header">
    <div class="container">
        <div class="header-bar">
            <div class="header-title">
                <a href="/" class="header-logo" data-ph="header__logo" aria-label="Dev Academy home">
                    <img src="<%- url_for('/img/dev-academy-logo.png') %>" width="34" height="34" alt="">
                    <span>Dev Academy</span>
                </a>
            </div>
            <a class="button button-primary header-bar-start" href="#get-free-pills" data-ph="header__pills-button_mobile">Get the free Pills</a>
            <button
                class="header-nav-toggle"
                type="button"
                aria-label="Click here to open the mobile menu"
                aria-controls="primary-navigation"
                aria-expanded="false"
                data-ph="header-nav-toggle__button">
                <img class="header-nav-toggle-menu" src="<%- url_for('/img/icons/menu.svg') %>" width="24" height="24" alt="">
                <img class="header-nav-toggle-close" src="<%- url_for('/img/icons/close.svg') %>" width="24" height="24" alt="">
            </button>
        </div>
        <div class="header-menu">
            <nav class="header-nav" id="primary-navigation" aria-label="Primary navigation">
                <ul>
                    <li><a class="header-nav-link <%- is_current('/articles/') ? 'header-nav-link-active' : '' %>" href="/articles/" data-ph="nav__link_articles">Articles</a></li>
                    <li><a class="header-nav-link <%- is_current('/podcast/') ? 'header-nav-link-active' : '' %>" href="/podcast/" data-ph="nav__link_podcast">Podcast</a></li>
                    <li><a class="header-nav-link <%- is_current('/web-security/') ? 'header-nav-link-active' : '' %>" href="/web-security/" data-ph="nav__link_web_security">Web Security</a></li>
                    <li><a class="header-nav-link <%- is_current('/about') ? 'header-nav-link-active' : '' %>" href="/about" data-ph="nav__link_about">About</a></li>
                    <li class="header-nav-start"><a class="button button-primary" href="#get-free-pills" data-ph="header__pills-button_desktop">Get the free Pills</a></li>
                </ul>
            </nav>
        </div>
    </div>
</header>
